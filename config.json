{
  "version": "sina-tencent-v1",
  "market": {
    "include_shanghai": true,
    "include_shenzhen": true,
    "include_chinext": true,
    "include_star_market": false,
    "include_beijing": false
  },
  "data_source": {
    "max_workers": 4,
    "tencent_batch_size": 80
  },
  "screening": {
    "shortlist_size": 120,
    "top_n": 3,
    "min_price": 0,
    "max_price": 800
  },
  "indicators": {
    "ma_periods": [5, 10, 20, 60],
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "rsi_period": 14
  },
  "learning": {
    "enabled": true
  },
  "output": {
    "directory": "reports"
  }
}
