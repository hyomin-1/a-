{
  "version": "ashare-hunter-v4-100pts",
  "market": {
    "include_shanghai": true,
    "include_shenzhen": true,
    "include_chinext": true,
    "include_star_market": false,
    "include_beijing": false,
    "exclude_st": true,
    "exclude_delisting": true
  },
  "data_source": {
    "primary": "sina",
    "history": "tencent",
    "max_workers": 8,
    "request_timeout_seconds": 10
  },
  "screening": {
    "shortlist_size": 500,
    "top_n": 3,
    "min_price": 0,
    "max_price": 800,
    "min_day_pct": -10,
    "exclude_limit_up": true
  },
  "v4_params": {
    "atr_period": 14,
    "atr_stop_multiplier": 1.5,
    "ma_periods": [5, 10, 20, 60]
  },
  "learning": {
    "enabled": true,
    "persist_reports": true
  },
  "output": {
    "directory": "reports",
    "save_candidates": true,
    "save_top3": true
  }
}
